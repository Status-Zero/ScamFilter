<!-- Shows a new recovery code once, and makes sure it was saved before closing. -->
<Window x:Class="ScamFilter.Desktop.CodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Your recovery code" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Text="Save your recovery code" Margin="0,0,0,10" />
        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,16"
                   Text="If you ever forget your password, this code is the only way to set a new one. Write it down and keep it somewhere safe, away from your computer. Don't share it: anyone with it can change your protections." />
        <Border Background="{StaticResource WindowBrush}" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
            <TextBlock x:Name="CodeText" FontFamily="{StaticResource CodeFont}" FontSize="24" HorizontalAlignment="Center" />
        </Border>
        <Button Content="Copy code" HorizontalAlignment="Left" Click="Copy_Click" />
        <CheckBox x:Name="SavedBox" Margin="0,10,0,0" Content="I wrote down or saved my recovery code" Click="SavedBox_Click" />
        <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Left"
                Margin="0,18,0,0" IsEnabled="False" Click="Done_Click" />
    </StackPanel>
</Window>
