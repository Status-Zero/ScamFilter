<!--
  The main window: a navigation pane on the left and the pages on the right (Check, History,
  Protections, Account, and, in the developer environment only, Outlook, AI viewer, Model and
  Developer). Only one page is visible at a time; the code-behind (MainWindow.xaml.cs) switches
  between them and does all the work.
-->
<Window x:Class="ScamFilter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScamFilter"
        Icon="Assets/ScamFilter.ico"
        Width="1180" Height="800" MinWidth="1060" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- One row of the Blocked or Trusted list (see EntryRowItem) -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Icon}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Remove" VerticalAlignment="Center"
                        Margin="12,0,0,0" Click="RemoveEntry_Click" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation pane ===================== -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,22">
                <Image Source="Assets/ScamFilterLogo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="ScamFilter" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="22,0,20,20">
                <!-- Whose account is open -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock x:Name="AccountInitial" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountNameText" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <Button Style="{StaticResource LinkButton}" Content="Switch account" FontSize="12" HorizontalAlignment="Left"
                                Padding="0" Click="SwitchAccount_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}"
                           Text="Everything runs on this PC. Messages are never uploaded, and links are never opened." />
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Foreground="{StaticResource HintBrush}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavCheck" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE721;" />
                        <TextBlock Text="Check a message" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xEA18;" />
                        <TextBlock Text="Protections" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAccount" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;" />
                        <TextBlock Text="Account" />
                    </StackPanel>
                </RadioButton>
                <!-- Only in the developer environment (see App.xaml.cs): the developer tabs. Outlook is
                     here too: linking Outlook is a developer-only feature for now (App.ShowOutlook). -->
                <StackPanel x:Name="DeveloperNav" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Caption}" Text="DEVELOPER" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource HintBrush}" Margin="14,18,0,6" />
                    <RadioButton x:Name="NavOutlook" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavIcon}" Text="&#xE715;" />
                            <TextBlock Grid.Column="1" Text="Outlook" VerticalAlignment="Center" />
                            <!-- how many emails in the last Outlook check came out unsafe -->
                            <Border x:Name="OutlookBadge" Grid.Column="2" Background="{StaticResource UnsafeBrush}" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" Margin="10,0,0,0" Visibility="Collapsed"
                                    ToolTip="Unsafe emails in your last Outlook check">
                                <TextBlock x:Name="OutlookBadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavAiViewer" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE890;" />
                            <TextBlock Text="AI viewer" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavModel" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Text="Model" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDeveloper" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEC7A;" />
                            <TextBlock Text="Developer" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- The content area: a white sheet with a rounded top-left corner, like Windows 11 Settings -->
        <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>

                <!-- ===================== Page: Check a message ===================== -->
                <Grid x:Name="PageCheck" Margin="36,28,36,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Check a message" />
                    <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Paste a text or email below, or upload a screenshot, photo, PDF, or saved email." />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" MinWidth="360" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="4*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== Left: the message ===== -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <Border Background="{StaticResource NavSelectedBrush}" CornerRadius="5" HorizontalAlignment="Left" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TypeText" Style="{StaticResource Segment}" GroupName="Type" Content="Text message"
                                                     IsChecked="True" Checked="Type_Checked" />
                                        <RadioButton x:Name="TypeEmail" Style="{StaticResource Segment}" GroupName="Type" Content="Email"
                                                     Checked="Type_Checked" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="From" />
                                <TextBox x:Name="SenderBox" Tag="Phone number or email address (optional)" TextChanged="SenderBox_TextChanged" />
                                <TextBlock x:Name="EmailOnTextHint" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Run Text="That's an email address. Texts sent from email addresses are a common scam sign, so if this is really an email," />
                                    <Hyperlink Click="SwitchToEmail_Click">switch to Email</Hyperlink><Run Text="." />
                                </TextBlock>

                                <StackPanel x:Name="EmailFields" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sender name" />
                                    <TextBox x:Name="NameBox" Tag="The name your inbox shows, like PayPal Support" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Subject" />
                                    <TextBox x:Name="SubjectBox" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Message" />
                                <TextBox x:Name="BodyBox" MinHeight="230" MaxHeight="420" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         TextChanged="BodyBox_TextChanged"
                                         Tag="Paste the message here. With a screenshot copied, press Ctrl+V to read the text out of it." />

                                <!-- Shown when the message came from a file, a screenshot, or a rich paste -->
                                <Border x:Name="ImportBar" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8"
                                        Background="#EFF6FC" BorderBrush="#C7E0F4" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE946;"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                                <Run x:Name="ImportNoteText" />
                                                <Hyperlink Click="DetachImport_Click">Use only the text</Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="OpenInOutlookText" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed">
                                                <Hyperlink Click="OpenInOutlook_Click">Open this email in Outlook</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <CheckBox x:Name="ContactBox" Margin="0,14,0,0" Content="This sender is in my contacts" />
                                <CheckBox x:Name="RepliedBox" Margin="0,10,0,0" Content="I've messaged this sender before" />

                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="CheckButton" Style="{StaticResource PrimaryButton}" Content="Check message"
                                            Click="CheckButton_Click" ToolTip="Ctrl+Enter" />
                                    <Button x:Name="UploadButton" Click="OpenFileButton_Click"
                                            ToolTip="A screenshot, photo, PDF, or saved email from this PC (Ctrl+O)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE898;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Upload a file..." />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Clear" Click="ClearButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="CheckStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Right: the result ===== -->
                        <Grid Grid.Column="2">
                            <!-- Before anything has been checked: how to get a message in -->
                            <Border x:Name="ResultEmpty" BorderBrush="{StaticResource BorderBrushInput}" BorderThickness="1"
                                    CornerRadius="8" VerticalAlignment="Top" Padding="24,26">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="28" Text="&#xEA18;"
                                               Foreground="{StaticResource HintBrush}" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Your result will show up here, with the reasons behind it." Margin="0,0,0,18" />
                                    <TextBlock Style="{StaticResource SectionHeading}" Text="Ways to bring in a message" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,8"
                                               Text="Copy an email in Outlook or Gmail and paste it here. Pasting keeps where each link really goes, which is the best clue." />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                               Text="Take a screenshot of a text with Win+Shift+S, then press Ctrl+V here." />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                               Text="Upload a screenshot, a photo of a letter or screen, or a PDF (like an invoice) with Upload a file. Its text is read on this PC." />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                               Text="Drag an email straight out of Outlook, or drop a saved .eml or .msg file." />
                                    <!-- Developer environment only (App.ShowOutlook) -->
                                    <TextBlock x:Name="LinkOutlookTip" Style="{StaticResource BodyText}">
                                        <Run Text="Or" />
                                        <Hyperlink Click="GoToOutlook_Click">link your Outlook account</Hyperlink><Run Text=" to check your newest emails all at once." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="ResultView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel>
                                    <!-- The verdict band: the one loud thing in the app -->
                                    <Border x:Name="VerdictBand" CornerRadius="8,8,0,0" Padding="24,20" Background="{StaticResource SafeBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="VerdictIcon" Grid.Column="0" FontFamily="{StaticResource IconFont}"
                                                       FontSize="34" Foreground="White" Margin="0,4,18,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="VerdictTitle" FontFamily="{StaticResource DisplayFont}" FontSize="32"
                                                           FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock x:Name="VerdictSummary" FontSize="15" Foreground="White"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="21" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="24,18,24,16">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeading}" Text="Why" />
                                            <StackPanel x:Name="ReasonsList" Margin="0,0,0,10" />

                                            <StackPanel x:Name="LinksSection">
                                                <TextBlock Style="{StaticResource SectionHeading}" Text="Links in this message" Margin="0,8,0,4" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                                           Text="Where each link really goes. Shown as plain text: ScamFilter never opens links." />
                                                <StackPanel x:Name="LinksList" Margin="0,0,0,6" />
                                            </StackPanel>

                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="BlockSenderButton" Content="Block sender" Click="BlockSenderButton_Click" />
                                                <Button x:Name="BlockSitesButton" Content="Block these sites" Click="BlockSitesButton_Click" />
                                                <Button x:Name="TrustSenderButton" Content="Trust sender" Click="TrustSenderButton_Click" />
                                            </WrapPanel>

                                            <!-- Reports: the most useful examples ScamFilter can learn from -->
                                            <StackPanel x:Name="CorrectionArea" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                                           Text="Wrong answer? Tell ScamFilter, and it'll do better with messages like this one." />
                                                <WrapPanel>
                                                    <Button x:Name="MarkScamButton" Content="This is a scam" Click="MarkScamButton_Click" />
                                                    <Button x:Name="MarkSafeButton" Content="This is safe" Click="MarkSafeButton_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock x:Name="CorrectionSaved" Style="{StaticResource Caption}" Margin="0,8,0,8" Visibility="Collapsed">
                                                <Run x:Name="CorrectionSavedText" />
                                            </TextBlock>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===================== Page: Outlook ===================== -->
                <Grid x:Name="PageOutlook" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Outlook" />
                        <StackPanel x:Name="OutlookAccountBar" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="OutlookUserText" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <Button Content="Unlink" Margin="0" Click="OutlookSignOut_Click"
                                    ToolTip="Stop checking this mailbox and forget the sign-in on this PC" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Checks the newest emails in your Outlook mailbox. ScamFilter reads your mail but never changes, deletes, or moves it, and never opens the links in it. The only email it sends is alerts, if you turn them on." />

                    <!-- ===== This copy of ScamFilter has no Microsoft app registration built in ===== -->
                    <Border x:Name="OutlookUnavailablePanel" Grid.Row="2" Style="{StaticResource Panel}" MaxWidth="760"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeading}" Text="Outlook linking isn't set up in this copy" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Microsoft only lets registered apps read mail, and this copy of ScamFilter was built without its registration. Everything else works. Whoever gave you ScamFilter can turn this on with a new build." />
                        </StackPanel>
                    </Border>

                    <!-- ===== Signed out ===== -->
                    <Border x:Name="OutlookSignInPanel" Grid.Row="2" Style="{StaticResource Panel}" MaxWidth="760"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeading}" Text="Link your Outlook account" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,16"
                                       Text="Your web browser opens to Microsoft's own sign-in page. ScamFilter never sees your password, and the sign-in is saved encrypted on this PC so you don't have to do it every time. Linking also lets you unlock ScamFilter with your Microsoft account, and send alerts." />
                            <WrapPanel>
                                <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Content="Sign in with Microsoft"
                                        Click="OutlookSignIn_Click" />
                                <Button x:Name="CancelSignInButton" Content="Cancel" Click="OutlookCancelSignIn_Click" Visibility="Collapsed" />
                            </WrapPanel>
                            <TextBlock x:Name="SignInStatus" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Signed in: the toolbar and the list ===== -->
                    <Grid x:Name="OutlookToolbar" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Background="{StaticResource NavSelectedBrush}" CornerRadius="5" Padding="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FolderInbox" Style="{StaticResource Segment}" GroupName="Folder" Content="Inbox"
                                                 IsChecked="True" Checked="OutlookFolder_Checked" />
                                    <RadioButton x:Name="FolderJunk" Style="{StaticResource Segment}" GroupName="Folder" Content="Junk Email"
                                                 Checked="OutlookFolder_Checked" />
                                </StackPanel>
                            </Border>
                            <ComboBox x:Name="OutlookCountBox" Width="128" Margin="12,0,0,0" VerticalAlignment="Center" SelectedIndex="0"
                                      SelectionChanged="OutlookCount_SelectionChanged">
                                <ComboBoxItem Tag="25" Content="Newest 25" />
                                <ComboBoxItem Tag="50" Content="Newest 50" />
                                <ComboBoxItem Tag="100" Content="Newest 100" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="AutoCheckBox" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"
                                  Content="Check for new mail every 5 minutes" Click="AutoCheck_Click" />
                        <Button x:Name="OutlookRefreshButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0"
                                Content="Check now" Click="OutlookRefresh_Click" ToolTip="F5" />
                    </Grid>

                    <Grid x:Name="OutlookListArea" Grid.Row="3" Visibility="Collapsed">
                        <TextBlock x:Name="OutlookEmpty" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="No emails here." Visibility="Collapsed" />
                        <ListBox x:Name="OutlookList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource HistoryRow}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OutlookList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,7" ToolTip="{Binding Tip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding BandBrush}" CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BandText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding From}" FontWeight="{Binding Weight}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Subject}" FontWeight="{Binding Weight}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding When}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <ProgressBar x:Name="OutlookProgress" IsIndeterminate="True" Visibility="Hidden" Margin="0,0,0,6" />
                        <TextBlock x:Name="OutlookStatus" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>

                <!-- ===================== Page: History ===================== -->
                <Grid x:Name="PageHistory" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource PageTitle}" Text="History" />
                        <Button x:Name="ClearHistoryButton" Content="Clear history" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0" Click="ClearHistoryButton_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Messages you've checked since opening ScamFilter. Select one to see its result again. History is cleared when you close the app." />
                    <TextBlock x:Name="HistoryEmpty" Grid.Row="2" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Nothing checked yet. Messages you check will show up here." />
                    <ListBox x:Name="HistoryList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource HistoryRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistoryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding BandBrush}" CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BandText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Grid.Column="2" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ===================== Page: Protections ===================== -->
                <Grid x:Name="PageLists" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Protections" />
                        <!-- Locked / unlocked, with a button to change it -->
                        <Border x:Name="LockPill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="14"
                                Background="{StaticResource NavSelectedBrush}" Padding="12,4,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LockIcon" FontFamily="{StaticResource IconFont}" Text="&#xE72E;" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="LockText" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" Text="Locked" />
                                <Button x:Name="LockButton" Style="{StaticResource LinkButton}" Content="Unlock" Click="LockButton_Click"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ProtectionsSubtitle" Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Who to always warn you about, who to trust, and who to tell when something's wrong. Anything that weakens your protection (trusting someone, unblocking, changing alerts) asks for your password first." />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ===== Blocked ===== -->
                                <Border Grid.Column="0" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE733;" Foreground="{StaticResource UnsafeBrush}"
                                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Style="{StaticResource SectionHeading}" Text="Blocked" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                                   Text="Messages from these senders, or with links to these websites, are marked Unsafe right away." />
                                        <TextBox x:Name="BlockInput" Tag="Phone number, email address, or website" KeyDown="BlockInput_KeyDown" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BlockLabel" Tag="Note (optional), like &quot;toll scam&quot;" MaxLength="40" KeyDown="BlockInput_KeyDown" />
                                            <Button Grid.Column="1" Content="Block" Margin="8,0,0,0" Click="AddBlocked_Click" />
                                        </Grid>
                                        <TextBlock x:Name="BlockStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="BlockEmpty" Style="{StaticResource Caption}" Margin="0,12,0,0" Foreground="{StaticResource HintBrush}"
                                                   Text="Nothing blocked yet. You can also block a sender right from a result on the Check page." />
                                        <ListBox x:Name="BlockList" BorderThickness="0" Background="Transparent" MaxHeight="300" Margin="-10,8,-10,0"
                                                 ItemContainerStyle="{StaticResource EntryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemTemplate="{StaticResource EntryTemplate}" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== Trusted ===== -->
                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" Foreground="{StaticResource SafeBrush}"
                                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Style="{StaticResource SectionHeading}" Text="Trusted" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                                   Text="Messages from these senders are marked Safe, unless they read like a scam (their account could be hacked). Companies can't be trusted this way: scammers send fake bills through real companies' systems." />
                                        <TextBox x:Name="TrustInput" Tag="Phone number, email address, or website" KeyDown="TrustInput_KeyDown" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TrustLabel" Tag="Name (optional), like &quot;Mom&quot;" MaxLength="40" KeyDown="TrustInput_KeyDown" />
                                            <Button Grid.Column="1" Content="Trust" Margin="8,0,0,0" Click="AddTrusted_Click" />
                                        </Grid>
                                        <TextBlock x:Name="TrustStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="TrustEmpty" Style="{StaticResource Caption}" Margin="0,12,0,0" Foreground="{StaticResource HintBrush}"
                                                   Text="Nobody trusted yet. Good candidates: family, friends, school, your doctor's office." />
                                        <ListBox x:Name="TrustList" BorderThickness="0" Background="Transparent" MaxHeight="300" Margin="-10,8,-10,0"
                                                 ItemContainerStyle="{StaticResource EntryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemTemplate="{StaticResource EntryTemplate}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ===== Alerts (sent through the linked Outlook, so developer environment only for now) ===== -->
                            <Border x:Name="AlertsPanel" Style="{StaticResource Panel}" Margin="0,20,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA8F;" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Style="{StaticResource SectionHeading}" Text="Alerts" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                               Text="Email someone you trust, like a family member, when something's wrong. Alerts never include the scam's links, and they're sent from your linked Outlook account (a copy lands in your Sent folder)." />
                                    <Border x:Name="AlertProblemBar" Visibility="Collapsed" Margin="0,0,0,12" Padding="12,8"
                                            Background="#FFF4CE" BorderBrush="#F2D57C" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource CautionBrush}"
                                                       Margin="0,2,10,0" VerticalAlignment="Top" />
                                            <TextBlock x:Name="AlertProblemText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                                            <Button x:Name="AlertFixButton" Grid.Column="2" Margin="12,0,0,0" Click="AlertFix_Click" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Who to email" />
                                            <TextBlock x:Name="ContactsEmpty" Style="{StaticResource Caption}" Foreground="{StaticResource HintBrush}"
                                                       Text="No one yet. Add up to 3 people." />
                                            <ListBox x:Name="ContactList" BorderThickness="0" Background="Transparent" Margin="-10,0,-10,6"
                                                     ItemContainerStyle="{StaticResource EntryRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE715;" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Email}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Remove" VerticalAlignment="Center"
                                                                    Click="RemoveContact_Click" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid x:Name="AddContactRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ContactNameInput" Tag="Name" MaxLength="40" Margin="0,0,8,0" />
                                                <TextBox x:Name="ContactEmailInput" Grid.Column="1" Tag="Email address" KeyDown="ContactEmail_KeyDown" />
                                                <Button Grid.Column="2" Content="Add" Margin="8,0,0,0" Click="AddContact_Click" />
                                            </Grid>
                                            <TextBlock x:Name="ContactStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,8" Text="Send an alert when" />
                                            <CheckBox x:Name="AlertUnsafeBox" Content="A message comes out Unsafe" Click="AlertToggle_Click" />
                                            <CheckBox x:Name="AlertPasswordBox" Margin="0,10,0,0" Content="Someone enters the wrong password 5 times" Click="AlertToggle_Click" />
                                            <CheckBox x:Name="AlertChangeBox" Margin="0,10,0,0" Content="Protections are changed (trusting, unblocking, alerts)" Click="AlertToggle_Click" />
                                            <WrapPanel Margin="0,16,0,0">
                                                <Button x:Name="TestAlertButton" Content="Send a test alert" Click="TestAlert_Click" />
                                            </WrapPanel>
                                            <TextBlock x:Name="AlertSendingFrom" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== Page: Account ===================== -->
                <Grid x:Name="PageAccount" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Account" />
                    <TextBlock x:Name="AccountSubtitle" Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Each person on this PC has their own account, with their own lists, Outlook, and alerts." />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Foreground="{StaticResource TextSecondaryBrush}" Text="Name" Margin="0,0,0,14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AccountPageName" FontWeight="SemiBold" Margin="0,0,0,14" VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="Rename" Click="RenameAccount_Click" />

                                    <TextBlock Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" Text="Password" Margin="0,0,0,14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AccountPagePassword" Margin="0,0,0,14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Row="1" Grid.Column="2" x:Name="ChangePasswordButton" Content="Change password" Click="ChangePassword_Click" />

                                    <TextBlock Grid.Row="2" Foreground="{StaticResource TextSecondaryBrush}" Text="Recovery code" Margin="0,0,0,14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AccountPageRecovery" Margin="0,0,0,14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Row="2" Grid.Column="2" x:Name="NewCodeButton" Content="Make a new code" Click="NewRecoveryCode_Click" />

                                    <TextBlock Grid.Row="3" x:Name="MicrosoftRowLabel" Foreground="{StaticResource TextSecondaryBrush}" Text="Microsoft account" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AccountPageMicrosoft" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Row="3" Grid.Column="2" x:Name="MicrosoftAccountButton" Click="MicrosoftAccountButton_Click" Margin="0" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AccountStatus" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                            <TextBlock Style="{StaticResource SectionHeading}" Text="Other accounts" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Switch account" Click="SwitchAccount_Click" />
                                <Button Content="Add an account" Click="AddAccount_Click" />
                                <Button Style="{StaticResource DangerButton}" Content="Remove this account" Click="RemoveAccount_Click" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                                       Text="How safe is this? The password stops changes made through ScamFilter, including by someone talking you through it on the phone. Someone who can sign in to this Windows account could still edit ScamFilter's files directly; if they do, ScamFilter notices and reports it as a protection change." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== Page: Model ===================== -->
                <Grid x:Name="PageModel" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Model" />
                    <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="Developer page. The model retrains on its own in the background when results are marked; this page trains it right away and shows the report. In the developer environment it trains the developer copy of the model only." />

                    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Text="Last trained" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModelTrained" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Text="Training examples" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModelData" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Text="Text features" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModelFeatures" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Text="Cut-offs" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModelThresholds" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="The built-in examples come from public datasets (text messages, phishing and honeypot emails from 2019 to 2026, fraud emails, and normal emails) plus modern example texts and emails written for this project (see data\SOURCES.md). Real messages you mark teach it the most: each one counts five times." />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <WrapPanel>
                            <Button x:Name="TrainButton" Style="{StaticResource PrimaryButton}" Content="Train model" Click="TrainButton_Click" />
                            <Button Content="Open data folder" Click="OpenDataFolderButton_Click" />
                        </WrapPanel>
                        <ProgressBar x:Name="TrainProgress" IsIndeterminate="True" Visibility="Hidden" Margin="0,4,0,10" />
                    </StackPanel>

                    <TextBox x:Name="TrainLog" Grid.Row="4" Style="{StaticResource CodeBox}" IsReadOnly="True"
                             Tag="The training report appears here: how well the model did on messages it never saw, and the words it learned to watch for." />
                </Grid>

                <!-- ===================== Page: AI viewer (developer environment only) ===================== -->
                <Grid x:Name="PageAiViewer" Margin="36,28,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="AI viewer" />
                    <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                               Text="What the model learned, and exactly how it scored the last message you checked. Every number here is a weight times a value, added up: the same sum the model does." />
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <TextBlock x:Name="AiModelSummary" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionHeading}" Text="How the last message was scored" />
                            <TextBox x:Name="DetailsBox" Grid.Row="1" Style="{StaticResource CodeBox}" IsReadOnly="True" FontSize="12"
                                     Tag="Check a message on the Check page, then come back here to see every number behind the verdict." />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionHeading}" Text="Look up a word" />
                            <TextBox x:Name="AiLookupBox" Grid.Row="1" Tag="Type a word, like verify or gift card" TextChanged="AiLookupBox_TextChanged" />
                            <WrapPanel Grid.Row="2" Margin="0,10,0,10">
                                <Button Content="Strongest scam words" Click="AiTopScam_Click" />
                                <Button Content="Strongest safe words" Click="AiTopSafe_Click" />
                            </WrapPanel>
                            <TextBox x:Name="AiLookupResults" Grid.Row="3" Style="{StaticResource CodeBox}" IsReadOnly="True" FontSize="12"
                                     Tag="Matching features appear here, with their weights. Positive pushes toward scam, negative toward safe." />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===================== Page: Developer (developer environment only) ===================== -->
                <ScrollViewer x:Name="PageDeveloper" Margin="36,28,36,24" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Developer" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="You're in the developer environment: a separate copy of ScamFilter's data with its own model, lists, and Outlook sign-in. Nothing done here changes a real account." />
                        <Border Style="{StaticResource Panel}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeading}" Text="This environment" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Data folder" />
                                <TextBlock x:Name="DevDataFolderText" Style="{StaticResource BodyText}" FontFamily="{StaticResource CodeFont}"
                                           FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Open data folder" Click="OpenDataFolderButton_Click" />
                                    <Button Content="Leave developer environment" Click="LeaveDeveloper_Click" />
                                    <Button Style="{StaticResource DangerButton}" Content="Reset developer environment" Click="ResetDeveloper_Click" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="Reset deletes this folder (its model, lists, history of marked results, and Outlook sign-in) and starts the developer environment again from the built-in data." />
                                <TextBlock x:Name="DevStatus" Style="{StaticResource Caption}" Foreground="{StaticResource UnsafeBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                            <!-- Registering the app with Microsoft (used to live on the Outlook page) -->
                            <Border x:Name="OutlookSetupPanel" Style="{StaticResource Panel}" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeading}" Text="Outlook: the app's Microsoft registration" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                                           Text="Microsoft only lets an app read mail once the app is registered. Register it once (free, about five minutes), then put the ID in OutlookAppConfig.BuiltInClientId and rebuild, so the people using ScamFilter never see this. Saving it here only affects the developer environment, for testing; then use the Outlook page as usual." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="How to register ScamFilter" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="1" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,10">
                                        <Run Text="Open" />
                                        <Hyperlink NavigateUri="https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" RequestNavigate="Hyperlink_RequestNavigate">App registrations in the Microsoft Entra admin center</Hyperlink><Run Text=" and sign in with your Microsoft account. If it says your account has no directory, first make a free Azure account at " /><Hyperlink NavigateUri="https://azure.microsoft.com/free" RequestNavigate="Hyperlink_RequestNavigate">azure.microsoft.com/free</Hyperlink><Run Text=", which comes with one." />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,10"
                                               Text="Select New registration. Name it ScamFilter, and under Supported account types pick &quot;Any Entra ID tenant + Personal Microsoft accounts&quot;." />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,10">
                                        <Run Text="Under Redirect URI, pick &quot;Public client/native (mobile &amp; desktop)&quot; and type" />
                                        <Run Text="http://localhost" FontFamily="{StaticResource CodeFont}" /><Run Text=". Select Register." />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,10"
                                               Text="On the app's Overview page, copy the Application (client) ID and paste it below." />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="5" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,10"
                                               Text="Select Save and sign in. Microsoft asks once whether ScamFilter may read your mail; say yes. Nothing else needs to be set: the permissions are asked for at sign-in." />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Application (client) ID" />
                                <TextBox x:Name="ClientIdBox" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                         FontFamily="{StaticResource CodeFont}" KeyDown="ClientIdBox_KeyDown"
                                         Tag="Looks like 1a2b3c4d-1234-5678-9abc-def012345678" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Accounts" />
                                <ComboBox x:Name="AccountsBox" Width="420" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Tag="common" Content="Personal, work, or school (matches the choice in step 2)" />
                                    <ComboBoxItem Tag="consumers" Content="Personal accounts only (Outlook.com, Hotmail, Live)" />
                                    <ComboBoxItem Tag="organizations" Content="Work or school accounts only" />
                                </ComboBox>
                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="SaveSetupButton" Style="{StaticResource PrimaryButton}" Content="Save and sign in"
                                            Click="OutlookSaveSetup_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="SetupStatus" Style="{StaticResource Caption}" Foreground="{StaticResource UnsafeBrush}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ===================== Drop overlay ===================== -->
        <!-- Covers the window while a file or an email from Outlook is dragged over it -->
        <Grid x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" AllowDrop="True"
              Background="#E6FFFFFF" DragLeave="DropOverlay_DragLeave">
            <Border Margin="24" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="44" Text="&#xE896;" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16" />
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Text="Drop to check" />
                    <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Screenshots and photos, PDFs, emails (.eml, .msg, or dragged from Outlook), or text files" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
